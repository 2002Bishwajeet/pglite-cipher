+  /**
+   * Under `pack` > 1, inside the commit's transaction: slots as they are; each changed block id finds
+   * the record that holds it (keys first, then each such record once), and those records are written
+   * again with the changes, split evenly into records of at most `pack` blocks. Ids before every
+   * record make records of their own. No await: callbacks only, so the transaction stays open.
+   */
+  #writePacked(store: IDBObjectStore, batch: CommitBatch, fail: (error: Error) => void): void {
+    const pack = this.#pack;
+    const changes = new Map<BlockId, Uint8Array | null>();
+    try {
+      for (const key of batch.deletes) {
+        if (!isRecordKey(key)) throw invalidKey();
+        if (typeof key === 'number') store.delete(key);
+        else changes.set(key, null);
+      }
+      for (const [key, value] of batch.puts) {
+        if (!isRecordKey(key)) throw invalidKey();
+        // As unpacked: a partial view (or a SharedArrayBuffer's) is copied to its own bytes first.
+        const whole = value.byteOffset === 0 && value.byteLength === value.buffer.byteLength && value.buffer instanceof ArrayBuffer;
+        const own = whole ? value : value.slice();
+        if (typeof key === 'number') store.put(own, key);
+        else changes.set(key, own);
+      }
+    } catch (error) {
+      fail(error as Error);
+      return;
+    }
+    const ids = [...changes.keys()];
+    if (ids.length === 0) return;
+    const held = new Map<BlockId, BlockId[]>(); // record key -> the changed ids it holds
+    const before: BlockId[] = []; // changed ids before every record
+    const put = (list: Entry[]) => {
+      const parts = Math.ceil(list.length / pack);
+      for (let i = 0; i < parts; i++) {
+        const part = list.slice(Math.floor((i * list.length) / parts), Math.floor(((i + 1) * list.length) / parts));
+        const [first] = part as [Entry];
+        store.put(part.length === 1 ? first[1] : part, first[0]);
+      }
+    };
+    const putBefore = () => {
+      put(before.flatMap((id): Entry[] => {
+        const value = changes.get(id) ?? null;
+        return value === null ? [] : [[id, value]];
+      }).sort(byId));
+    };
+    const rewrite = () => {
+      try {
+        let pending = held.size;
+        for (const [key, changed] of held) {
+          const request = store.get(key) as IDBRequest<Packed>;
+          request.onsuccess = () => {
+            try {
+              const blocks = new Map(unpack(key, request.result));
+              for (const id of changed) {
+                const value = changes.get(id) ?? null;
+                if (value === null) blocks.delete(id);
+                else blocks.set(id, value);
