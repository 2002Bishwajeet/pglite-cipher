diff --git a/src/fs/openWorker.ts b/src/fs/openWorker.ts
new file mode 100644
index 0000000..2729598
--- /dev/null
+++ b/src/fs/openWorker.ts
@@ -0,0 +1,35 @@
+// Bench patch #85: one range of the open in a dedicated worker (openWorkers.ts). It opens its own
+// IndexedDB connection, reads its range with readRange, decrypts with the DEK it was posted (a
+// non-extractable CryptoKey, cloned, never exported), and transfers the plaintext blocks back.
+import { IndexedDbBackend } from '../backend/indexeddb.ts';
+import { CorruptStoreError } from '../format/errors.ts';
+import { loadRange, opener, workerContext, type FromOpenWorker, type Opened, type ToOpenWorker } from './openWorkers.ts';
+
+const scope = globalThis as unknown as DedicatedWorkerGlobalScope;
+const post = (message: FromOpenWorker, transfer: Transferable[] = []) => {
+  scope.postMessage(message, transfer);
+};
+
+// The request did not clone here (a CryptoKey this engine cannot receive, say): say so, never hang.
+scope.addEventListener('messageerror', () => {
+  post({ type: 'error', corrupt: false, message: 'the request did not clone' });
+});
+
+scope.addEventListener('message', (event: MessageEvent<ToOpenWorker>) => {
+  const { name, range, pageSize, open } = event.data;
+  const backend = new IndexedDbBackend(name);
+  const decrypt = open && opener(workerContext(open.dek, open.meta), open.places, new Set(open.table));
+  const deliver = (opened: Opened[], records: number) => {
+    post({ type: 'page', opened, records }, opened.map((o) => o.plain.buffer));
+  };
+  loadRange((after, limit, before) => backend.readRange(after, limit, before), range, pageSize, decrypt, deliver)
+    .then((stats) => {
+      post({ type: 'done', stats });
+    })
+    .catch((error: unknown) => {
+      // Block ids and error names only: nothing of a key or a plaintext.
+      const corrupt = error instanceof CorruptStoreError;
+      post({ type: 'error', corrupt, message: corrupt ? error.message : error instanceof Error ? error.name : 'unknown' });
+    })
+    .finally(() => void backend.close());
+});
diff --git a/src/fs/openWorkers.ts b/src/fs/openWorkers.ts
new file mode 100644
index 0000000..9d3751f
--- /dev/null
+++ b/src/fs/openWorkers.ts
@@ -0,0 +1,235 @@
+// Bench patch #85 (bench/patches/workers.patch, never committed to src/): the open's blocks phase
+// split into W key ranges, each read and decrypted by its own dedicated worker. Chromium unwraps
+// every IndexedDB value over 64 KiB on the thread that calls getAll, so one thread cannot overlap
+// reads and decrypts (#76); W workers run W unwrap pipelines at once.
+//
+// A range reads pages of PAGE / W records with the next page in flight while one decrypts, so the
+// W ranges together hold at most what one reader held before: two pages of PAGE records (#10).
+// Where there is no Worker, or the backend is not IndexedDB, the ranges run on this thread. Where the
+// DEK does not clone to a worker (WebKit: DataCloneError for any CryptoKey), the open falls back to
+// the single-thread loader of src/; the key is never exported.
+import type { BlockId, StorageBackend } from '../backend/backend.ts';
+import { IndexedDbBackend } from '../backend/indexeddb.ts';
+import type { Bytes } from '../format/bytes.ts';
+import type { Meta } from '../format/codec.ts';
+import { CorruptStoreError } from '../format/errors.ts';
+import { SubkeyCache } from '../format/keys.ts';
+import { openBlock, tagOf, type RecordContext } from '../format/records.ts';
+import type { FileMap, MapFile } from './fileMap.ts';
+import { fromHex } from './fileMap.ts';
+import { PAGE, pool } from './pool.ts';
+
+let workers = 1;
+
+/** W, the open's ranges: 1 is the loader of src/ as it is. */
+export const openWorkers = (): number => workers;
+
+/** Sets W for the opens that follow (the bench page's `?workers=`, the tests' CIPHER_OPEN_WORKERS). */
+export function setOpenWorkers(w: number): void {
+  if (w !== 1 && w !== 2 && w !== 4) throw new RangeError('open workers must be 1, 2 or 4');
+  workers = w;
+}
+
+/** Ids `after < id < before`; null is open-ended. */
+export interface KeyRange {
+  after: BlockId | null;
+  before: BlockId | null;
+}
+
+/** W ranges split on the first hex digit of the random ids, so each holds about 1/W of the blocks. */
+export const keyRanges = (w: number): KeyRange[] => {
+  const cuts = Array.from({ length: w - 1 }, (_, i) => (((i + 1) * 16) / w).toString(16));
+  return Array.from({ length: w }, (_, i) => ({ after: cuts[i - 1] ?? null, before: cuts[i] ?? null }));
+};
+
+export interface Opened {
+  id: BlockId;
+  plain: Uint8Array<ArrayBuffer>;
+  tag: Bytes;
+}
+
+/** One range: wall time with a read in flight, with a decrypt in flight, and what it read. */
+export interface RangeStats {
+  readMs: number;
+  decryptMs: number;
+  records: number;
+  bytes: number;
+}
+
+const now = (): number => globalThis.performance.now();
+
+/** Wall time with at least one call in flight; overlapping calls count once. */
+class Busy {
+  #inFlight = 0;
+  #since = 0;
+  ms = 0;
+  async time<T>(call: () => Promise<T>): Promise<T> {
+    if (this.#inFlight++ === 0) this.#since = now();
+    try {
+      return await call();
+    } finally {
+      if (--this.#inFlight === 0) this.ms += now() - this.#since;
+    }
+  }
+}
+
+type Read = (after: BlockId | null, limit: number, before: BlockId | null) => Promise<Array<[BlockId, Uint8Array]>>;
+type Open = (id: BlockId, sealed: Bytes) => Promise<Opened | null>;
+type Deliver = (opened: Opened[], records: number) => void;
+
+/** Opens a block as the loader does; null for a table block. Data block places are `[fileId, index]`. */
+export const opener =
+  (ctx: RecordContext, places: ReadonlyMap<BlockId, readonly [Bytes, number]>, table: ReadonlySet<BlockId>): Open =>
+  async (id, sealed) => {
+    if (table.has(id)) return null;
+    const place = places.get(id);
+    if (!place) throw new CorruptStoreError(`block ${id}: not in the file table`);
+    const plain = await openBlock(ctx, fromHex(id), place[0], place[1], sealed);
+    return { id, plain, tag: tagOf(sealed).slice() };
+  };
+
+/**
+ * Reads one range in pages of `pageSize`, the next page in flight while this one decrypts, and
+ * hands each page's opened data blocks to `deliver` in key order, with the page's record count.
+ * With `open` null nothing is decrypted (the bench's reads-only row). Stops reading once `stopped()`.
+ */
+export async function loadRange(read: Read, range: KeyRange, pageSize: number, open: Open | null, deliver: Deliver, stopped: () => boolean = () => false): Promise<RangeStats> {
+  const reading = new Busy();
+  const decrypting = new Busy();
+  const stats: RangeStats = { readMs: 0, decryptMs: 0, records: 0, bytes: 0 };
+  const readPage = (after: BlockId | null) => {
+    const next = reading.time(() => read(after, pageSize, range.before));
+    next.catch(() => undefined); // awaited below; not unhandled if this page's decrypt throws first
+    return next;
+  };
+  for (let next: Promise<Array<[BlockId, Uint8Array]>> | null = readPage(range.after); next && !stopped(); ) {
+    let page: Array<[BlockId, Uint8Array]> = await next;
+    const full = page.length === pageSize;
+    const end = range.before === null ? -1 : page.findIndex(([id]) => id >= (range.before as BlockId));
+    if (end !== -1) page = page.slice(0, end);
+    if (page.length === 0) break;
+    next = full && end === -1 ? readPage((page[page.length - 1] as [BlockId, Uint8Array])[0]) : null;
+    stats.records += page.length;
+    for (const [, sealed] of page) stats.bytes += sealed.byteLength;
+    const opened: Array<Opened | null> = new Array<Opened | null>(page.length).fill(null);
+    if (open) {
+      const at = new Map(page.map(([id], i) => [id, i]));
+      await pool(page, async ([id, sealed]) => {
+        opened[at.get(id) as number] = await decrypting.time(() => open(id, sealed as Bytes));
+      });
+    }
+    if (!stopped()) deliver(opened.filter((o): o is Opened => o !== null), page.length);
+  }
+  stats.readMs = reading.ms;
+  stats.decryptMs = decrypting.ms;
+  return stats;
