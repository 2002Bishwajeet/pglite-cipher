+
+/**
+ * Runs the W ranges, each in a worker or on this thread; the first failure stops them all. Null when
+ * this engine cannot post a range's request to a worker (WebKit cannot clone a CryptoKey there, #85):
+ * the caller then uses the single-thread loader. Nothing has been read or delivered by then.
+ */
+async function runRanges(backend: StorageBackend, w: number, toWorker: (i: number) => ToOpenWorker, here: (i: number, deliver: Deliver, stopped: () => boolean) => Promise<RangeStats>, deliver: Deliver): Promise<RangeStats[] | null> {
+  let failed = false;
+  const guarded: Deliver = (opened, records) => {
+    if (!failed) deliver(opened, records);
+  };
+  const fail = (error: unknown): never => {
+    failed = true;
+    throw error;
+  };
+  const each = Array.from({ length: w }, (_, i) => i);
+  if (!workerUsable(backend)) return Promise.all(each.map((i) => here(i, guarded, () => failed).catch(fail)));
+  const started = each.map(newWorker);
+  try {
+    const results = each.map((i) => settled(started[i] as Worker, guarded).catch(fail));
+    try {
+      for (const i of each) (started[i] as Worker).postMessage(toWorker(i));
+    } catch (error) {
+      failed = true;
+      if (error instanceof DOMException && error.name === 'DataCloneError') return null;
+      throw error;
+    }
+    return await Promise.all(results);
+  } finally {
+    for (const worker of started) worker.terminate();
+  }
+}
+
+type Places = Map<BlockId, readonly [Bytes, number]>;
+
+/**
+ * The open's blocks phase in W ranges: `deliver` gets every opened data block, in key order per range.
+ * Null when the DEK does not clone to a worker (WebKit): the caller loads on its own thread instead.
+ */
+export function loadInRanges(backend: StorageBackend, ctx: RecordContext, map: FileMap, tableIds: readonly BlockId[], w: number, deliver: Deliver): Promise<RangeStats[] | null> {
+  const pageSize = PAGE / w;
+  const ranges = keyRanges(w);
+  const rangeOf = (id: BlockId) => ranges.findIndex((r) => (r.after === null || id > r.after) && (r.before === null || id < r.before));
+  const places = ranges.map((): Places => new Map());
+  for (const [id, { key, index }] of map.places) places[rangeOf(id)]?.set(id, [(map.files.get(key) as MapFile).fileId, index]);
+  const table = ranges.map((): BlockId[] => []);
+  for (const id of tableIds) table[rangeOf(id)]?.push(id);
+  const read: Read = (after, limit, before) => backend.readRange(after, limit, before);
+  return runRanges(
+    backend,
+    w,
+    (i) => ({ name: (backend as IndexedDbBackend).name, range: ranges[i] as KeyRange, pageSize, open: { dek: ctx.subkeys.baseKey, meta: ctx.meta, places: places[i] as Places, table: table[i] as BlockId[] } }),
+    (i, into, stopped) => loadRange(read, ranges[i] as KeyRange, pageSize, opener(ctx, places[i] as Places, new Set(table[i])), into, stopped),
+    deliver,
+  );
+}
+
+/** The bench's reads-only row with W ranges: every record read as the open reads it, nothing decrypted. */
+export function readInRanges(backend: StorageBackend, w: number): Promise<RangeStats[] | null> {
+  const pageSize = PAGE / w;
+  const ranges = keyRanges(w);
+  const read: Read = (after, limit, before) => backend.readRange(after, limit, before);
+  return runRanges(
+    backend,
+    w,
+    (i) => ({ name: (backend as IndexedDbBackend).name, range: ranges[i] as KeyRange, pageSize, open: null }),
+    (i, into, stopped) => loadRange(read, ranges[i] as KeyRange, pageSize, null, into, stopped),
+    () => undefined,
+  );
+}
+
+/** For openWorker.ts: the open's context in a worker, from the DEK it was posted. */
+export const workerContext = (dek: CryptoKey, meta: Meta): RecordContext => ({ subkeys: new SubkeyCache(dek), meta, encryptions: 0 });
