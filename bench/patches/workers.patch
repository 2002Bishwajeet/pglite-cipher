+
+export type FromOpenWorker =
+  | { type: 'page'; opened: Opened[]; records: number }
+  | { type: 'done'; stats: RangeStats }
+  | { type: 'error'; corrupt: boolean; message: string };
+
+/** Listens to one range's worker; settles once it is done or failed. */
+function settled(worker: Worker, deliver: Deliver): Promise<RangeStats> {
+  return new Promise((resolve, reject) => {
+    worker.onmessage = (event: MessageEvent<FromOpenWorker>) => {
+      const m = event.data;
+      if (m.type === 'page') deliver(m.opened, m.records);
+      else if (m.type === 'done') resolve(m.stats);
+      else reject(m.corrupt ? new CorruptStoreError(m.message) : new Error(`EncryptedFs: an open worker failed: ${m.message}`));
+    };
+    worker.onmessageerror = () => {
+      reject(new Error('EncryptedFs: an open worker sent what does not clone'));
+    };
+    worker.onerror = (event) => {
+      event.preventDefault();
+      reject(new Error('EncryptedFs: an open worker failed'));
+    };
