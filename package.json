{
  "name": "pglite-cipher",
  "version": "0.1.0",
  "description": "Encryption at rest for PGlite: AES-256-GCM through WebCrypto, blocks in IndexedDB, like SQLCipher for Postgres in the browser.",
  "keywords": [
    "pglite",
    "postgres",
    "encryption",
    "sqlcipher",
    "indexeddb",
    "webcrypto",
    "aes-gcm",
    "browser"
  ],
  "homepage": "https://github.com/2002Bishwajeet/pglite-cipher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2002Bishwajeet/pglite-cipher.git"
  },
  "bugs": {
    "url": "https://github.com/2002Bishwajeet/pglite-cipher/issues"
  },
  "author": "Bishwajeet Parhi",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CLA.md",
    "FORMAT.md",
    "SECURITY.md",
    "THIRD_PARTY.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project node",
    "test:browser": "node scripts/test-browser.mjs",
    "test:long": "CIPHER_LONG=1 vitest run --project node",
    "bench:build": "vite build --config bench/vite.config.ts",
    "bench:serve": "vite preview --config bench/vite.config.ts",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-pgvector": "0.0.17",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "playwright": "1.65.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
